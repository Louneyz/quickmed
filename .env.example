# Portal mode. Unset (default) = sales demo: any login opens a sample pharmacy that runs
# in the browser with made-up data and no database. Set to `live` for real logins.
NEXT_PUBLIC_PORTAL_MODE=

# Supabase project (create it in the Canada (Central) region).
# Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server only. Never prefix with NEXT_PUBLIC_ and never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Optional: the public URL used in invite emails (defaults to the request's own origin).
NEXT_PUBLIC_SITE_URL=https://quickmed.ca

# Email for the Become a partner / Become a driver pop-ups (resend.com, server only).
RESEND_API_KEY=
EMAIL_FROM=QuickMed <no-reply@quickmed.ca>
# Where new partner requests and driver applications (with resume) are sent.
QUICKMED_INBOX=info@quickmed.ca

# Used only by `npm run setup:portal` (run on your own computer, never on Vercel).
# Your QuickMed staff login for /admin (password at least 12 characters).
STAFF_EMAIL=you@quickmed.ca
STAFF_PASSWORD=
STAFF_NAME=Georgio
# Sales demo login: salespeople type DEMO_USERNAME and DEMO_PASSWORD on /login.
DEMO_USERNAME=Demo
DEMO_PASSWORD=
